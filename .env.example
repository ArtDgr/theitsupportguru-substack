# Copy to .env locally, add to GitHub Secrets for Actions
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini # score uses mini, synthesize uses gpt-4o
GEMINI_API_KEY=AIza... # Gemini 1.5 Flash free tier (aistudio.google.com/app/apikey) - preferred free
TAVILY_API_KEY=tvly-...
# Substack Email-to-Post secret address (Settings > Publication > Email > Secret address)
SUBSTACK_EMAIL=theitsupportguru....@substack.email
# SMTP for sending Email-to-Post (use Gmail App Password or custom domain)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@theitsupportguru.com
SMTP_PASS=app-password
SMTP_FROM=The IT Support Guru <you@theitsupportguru.com>
# 30d human gate via Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
# Gate: 0 = human approve, 1 = auto headless after 30d / 12 approved
AUTO_PUBLISH=0
# Optional Buffer free tier queue for X/LinkedIn (3 channels, 10 posts free)
BUFFER_TOKEN=your_buffer_access_token
BUFFER_PROFILE_IDS=abc123,def456 # from https://api.bufferapp.com/1/profiles.json?access_token=...
